# ============================================================
# HieuDe AI - NCKH Multi-Pipeline Configuration
# Copy file này thành .env và điền API keys thật
# ============================================================

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
PRIMARY_LLM=gemini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# --- Google Custom Search ---
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_CX=your_search_engine_id_here

# --- Search ---
SEARCH_N_RESULTS=5
SEARCH_TIMEOUT=15
SCRAPE_TIMEOUT=10

# --- Selenium ---
SELENIUM_HEADLESS=true

# --- Pipeline ---
WEIGHT_OCR_LLM=0.30
WEIGHT_OCR_SEARCH=0.30
WEIGHT_IMG_SEARCH=0.20
WEIGHT_ML_MATCH=0.20
PIPELINE_TIMEOUT=30
MIN_PIPELINE_RESPONSES=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_PIPELINE_DETAILS=true
