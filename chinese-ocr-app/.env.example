# ============================================================
# HieuDe AI - NCKH Multi-Pipeline Configuration
# Copy file này thành .env và điền API keys thật
# ============================================================

# --- LLM ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
PRIMARY_LLM=gemini
OPENCODE_VISION_MODEL=opencode/mimo-v2.5-free
OPENCODE_TIMEOUT=120
OLLAMA_VISION_MODEL=qwen3-vl:4b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# --- Google Custom Search ---
GOOGLE_CSE_API_KEY=your_google_custom_search_api_key
GOOGLE_CSE_CX=your_programmable_search_engine_id

# --- Search ---
SEARCH_METHOD=selenium
SEARCH_ALLOW_API_FALLBACK=false
SEARCH_N_RESULTS=5
SEARCH_TIMEOUT=15
SCRAPE_TIMEOUT=10

# --- Selenium ---
SELENIUM_HEADLESS=true
ENABLE_SELENIUM_IMAGE_SEARCH=true
ENABLE_GOOGLE_IMAGE_HTTP_UPLOAD=false

# --- Pipeline ---
WEIGHT_TEXT_VOTE=0.55
WEIGHT_VISION_GEMINI=0.40
WEIGHT_VISION_OPENCODE=0.40
WEIGHT_VISION_OLLAMA=0.38
WEIGHT_OCR_LLM=0.30
WEIGHT_OCR_SEARCH=0.30
WEIGHT_IMG_SEARCH=0.20
WEIGHT_ML_MATCH=0.20
PIPELINE_TIMEOUT=30
MIN_PIPELINE_RESPONSES=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_PIPELINE_DETAILS=true

# --- Contact form email ---
CONTACT_RECIPIENT=xuatruong30@gmail.com
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=your_gmail_address@gmail.com
CONTACT_SMTP_PASSWORD=your_gmail_app_password
CONTACT_FROM_EMAIL=your_gmail_address@gmail.com
